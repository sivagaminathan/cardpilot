# CardPilot - Environment Configuration Example
# Copy this file to .env and configure for local development.
# HARD RULE: Fictional data only. Never commit real secrets, API keys, or financial credentials.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
# Reverse proxy (set TRUST_PROXY_HEADERS=true in production behind Render)
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_COUNT=1

# Database (PostgreSQL)
# Local Docker Compose default (in production, use Neon pooled -pooler URL):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cardpilot
# Optional direct (non-pooler) URL for Alembic migrations in production:
# DIRECT_DATABASE_URL=postgresql+asyncpg://user:pass@ep-example.neon.tech/neondb?sslmode=require
# Optional SQLAlchemy / asyncpg pool settings:
# DB_STATEMENT_CACHE_SIZE=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cardpilot
POSTGRES_PORT=5432

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Observability (Local Docker Compose profile)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# On-Call Webhook Relay (optional; non-production only)
# GRAFANA_WEBHOOK_SECRET=replace-with-local-webhook-secret
# GITHUB_DISPATCH_TOKEN=replace-with-github-pat-when-testing-dispatch

