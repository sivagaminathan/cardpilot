{
  "title": "CardPilot API Observability",
  "uid": "cardpilot-api",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API Request Rate (req/s)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(cardpilot_http_requests_total[1m])) by (method, path)",
          "legendFormat": "{{method}} {{path}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API 5xx Error Rate (req/s)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(cardpilot_http_requests_total{status_code=~\"5..\"}[1m])) or vector(0)",
          "legendFormat": "5xx errors/s"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request Latency p95 (ms)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(cardpilot_http_request_duration_ms_milliseconds_bucket[5m])) by (le))",
          "legendFormat": "p95 latency (ms)"
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "CardPilot API Logs (with trace_id)",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{service_name=\"cardpilot-api\"}"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Recent Traces (Tempo)",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "queryType": "traceqlSearch",
          "filters": [
            { "id": "service-name", "tag": "service.name", "operator": "=", "value": ["cardpilot-api"], "scope": "resource" }
          ],
          "limit": 20
        }
      ]
    }
  ]
}
